{
  "name": "party-questions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vitest run && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:core && npm run typecheck:tests && npm run typecheck:app",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "content:sample": "tsx scripts/content-sample.ts",
    "content:promote": "tsx scripts/content-promote.ts",
    "content:similar": "tsx scripts/content-similar.ts",
    "apk": "node scripts/build-apk.mjs",
    "live:android": "node scripts/live-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
